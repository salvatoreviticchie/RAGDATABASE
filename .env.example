# ── Pinecone (required) ────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=rag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── OpenRouter (required for LLM) ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Embedding model (Pinecone Inference — no extra cost) ──────────────────────
# Options: llama-text-embed-v2 (1024d) | multilingual-e5-large (384d)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSIONS=1024

# ── LLM model (OpenRouter free models) ────────────────────────────────────────
# Free options: meta-llama/llama-3.3-70b-instruct:free | deepseek/deepseek-chat:free
#               mistralai/mistral-7b-instruct:free | qwen/qwq-32b:free
# Note: google/gemma-3-27b-it:free does NOT support system messages — avoid it
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Vision model (for image ingestion) ────────────────────────────────────────
# Used to describe images before embedding. Needs a vision-capable model.
# Paid: meta-llama/llama-3.2-11b-vision-instruct | google/gemini-flash-1.5
# Free: meta-llama/llama-3.2-11b-vision-instruct:free (may be rate-limited)
VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# ── Chunking & retrieval ───────────────────────────────────────────────────────
# CHUNK_SIZE: tokens per chunk. Larger = more context per result, less precision.
#   512  → fast, precise — good for FAQs, short docs
#   1024 → balanced — recommended for most documents       ← default
#   2048 → maximum context — best for long reports/books (slower indexing)
CHUNK_SIZE=1024

# CHUNK_OVERLAP: tokens shared between adjacent chunks.
# Prevents information loss at chunk boundaries.
# Rule of thumb: ~10–15% of CHUNK_SIZE
#   64  → minimal overlap
#   128 → recommended                                      ← default
#   256 → high overlap (more redundancy, better boundary coverage)
CHUNK_OVERLAP=128

# TOP_K: number of chunks retrieved per query and sent to the LLM.
# Higher = more context, slightly higher token cost per question.
#   5  → fast, focused
#   8  → recommended — better coverage for complex questions ← default
#   12 → maximum — use for very long or multi-topic documents
TOP_K=8
