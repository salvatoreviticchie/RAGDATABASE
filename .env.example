# ── Pinecone (required) ────────────────────────────────────────────────────────
PINECONE_API_KEY=pcsk-...
PINECONE_INDEX_NAME=rag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ── OpenRouter (required for LLM) ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Embedding model (Pinecone Inference — no extra cost) ──────────────────────
# Options: llama-text-embed-v2 (1024d) | multilingual-e5-large (384d)
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSIONS=1024

# ── LLM model (OpenRouter free models) ────────────────────────────────────────
# Free options: meta-llama/llama-3.3-70b-instruct:free | deepseek/deepseek-chat:free
#               mistralai/mistral-7b-instruct:free | qwen/qwq-32b:free
# Note: google/gemma-3-27b-it:free does NOT support system messages — avoid it
LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ── Chunking & retrieval ───────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
